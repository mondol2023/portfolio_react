# Copy this file to `.env.local` and fill in the values from your Firebase
# project. `.env.local` is gitignored — never commit real credentials.
#
#   cp .env.example .env.local
#
# Every variable below is documented in README.md → "Environment variables".


# ---------------------------------------------------------------------------
# Administrator account
# ---------------------------------------------------------------------------
# The Firebase Auth account that owns the CMS. Optional, and it grants nothing
# on its own — it is only the default address for `npm run set-admin`, which
# still needs the private credentials below. Real access is the custom claim
# `admin: true` plus a document at `admins/{uid}`; see firestore.rules.

ADMIN_EMAIL=you@example.com


# Optional sign-in password for the account above, read once by `npm run seed`
# to create it in Firebase Authentication. Nothing reads it at runtime. Minimum
# 6 characters. Leave it blank to create the account in the console by hand, and
# clear it again once the account exists.

ADMIN_PASSWORD=


# ---------------------------------------------------------------------------
# Public Firebase configuration  (safe to expose)
# ---------------------------------------------------------------------------
# These are inlined into the JavaScript bundle by Next.js — that is what
# NEXT_PUBLIC_ means. They are safe to ship: they identify the project, they do
# not authorise anything. Access is enforced by firestore.rules and by the
# server-side admin check, not by the secrecy of these values.
#
# Where to find them: Firebase console → Project settings → General →
# "Your apps" → Web app → SDK setup and configuration → Config.
#
# Used only by the admin sign-in screen, to exchange an email and password for
# an ID token. No Firestore access happens in the browser.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# ---------------------------------------------------------------------------
# Private Firebase Admin credentials  (SECRET — server only)
# ---------------------------------------------------------------------------
# A service-account key. These credentials bypass Firestore security rules
# entirely and can read and write anything in the project.
#
# NEVER prefix these with NEXT_PUBLIC_. Doing so would inline your private key
# into JavaScript served to every visitor.
#
# Where to find them: Firebase console → Project settings → Service accounts →
# "Generate new private key". The downloaded JSON contains project_id,
# client_email and private_key.
#
# FIREBASE_PRIVATE_KEY must keep its literal \n escape sequences and stay
# wrapped in double quotes on a single line — the app unescapes them at runtime.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PRIVATE KEY-----\n"


# ---------------------------------------------------------------------------
# Site URL
# ---------------------------------------------------------------------------
# The canonical origin, used for metadata, Open Graph images, robots.txt and
# sitemap.xml. No trailing slash.
#
# Optional in development (defaults to http://localhost:3000) and on Vercel
# (falls back to VERCEL_PROJECT_PRODUCTION_URL). Set it explicitly for any other
# production host, otherwise canonical URLs and social previews point at
# localhost.

NEXT_PUBLIC_SITE_URL=https://your-domain.com


# ---------------------------------------------------------------------------
# Visitor analytics
# ---------------------------------------------------------------------------
# Salt for the per-day hash that rate-limits /api/track. The hash is computed
# in-request and thrown away — no IP address and no hash is ever stored — so
# this is a spam-resistance measure, not a privacy control. Optional; a shared
# default is used when unset. Any long random string works.

# ANALYTICS_SALT=

# ---------------------------------------------------------------------------
# Demo content
# ---------------------------------------------------------------------------
# While a public collection is empty, the site renders the sample projects,
# roles, skills and statistics from src/lib/constants/demo-content.ts so a fresh
# install is reviewable instead of blank. Each affected section says so with a
# "Sample data" badge, and the fallback switches itself off per collection as
# soon as you add real content in /admin.
#
# Set to `off` to render the real empty states instead. Any other value (or no
# value at all) leaves the demo content on.

# PORTFOLIO_DEMO_CONTENT=off


# ---------------------------------------------------------------------------
# Project imagery from GitHub  (optional feature)
# ---------------------------------------------------------------------------
# Powers the "Images from the repository" panel under Media & links in the
# project editor. Every variable below is optional — with none of them set the
# panel still generates covers and pulls screenshots out of a public README.
# See src/features/repo-imagery/README.md.

# Raises GitHub's unauthenticated limit of 60 requests an hour per IP. A
# fine-grained token with no scopes at all is enough; the feature only reads
# public repositories.

# GITHUB_TOKEN=

# Enables the "Related photos" source. Free, from
# https://unsplash.com/oauth/applications — the Access Key, not the Secret.
# Without it the other two sources still work and the panel says so.

# UNSPLASH_ACCESS_KEY=

# Signs the generated-cover URLs so /api/repo-imagery/cover renders only images
# this site produced. A published default is used when unset, which means the
# signature is forgeable until you set this. Any long random string works.
#
# Changing it invalidates cover URLs already saved on projects — they will stop
# loading until the covers are picked again.

# REPO_IMAGERY_SECRET=
